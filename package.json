{
  "name": "superlandings",
  "version": "1.0.0",
  "description": "Manage and publish multiple landing pages (HTML, static, EJS) with admin panel, Traefik custom domains, CLI, and Docker.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --verbose --ignore data --ignore ref* --watch routes --watch server.js --watch lib server.js",
    "cli": "node cli.js",
    "test": "node --test --test-timeout=15000 tests/*.test.js && node --test --test-timeout=15000 --test-concurrency=1 tests/functional/*.test.js",
    "test:unit": "c8 --include='lib/**/*.js' --report-dir=coverage/unit node --test --test-timeout=15000 tests/*.test.js",
    "test:functional": "c8 --include='routes/**/*.js' --include='app.js' --report-dir=coverage/functional node --test --test-timeout=15000 --test-concurrency=1 tests/functional/*.test.js",
    "test:coverage": "npm run test:unit && npm run test:functional && node scripts/build-coverage-docs.js"
  },
  "keywords": [
    "landing pages",
    "static sites",
    "ejs",
    "traefik",
    "reverse-proxy",
    "custom domains",
    "admin panel",
    "cms",
    "docker",
    "docker-compose",
    "publishing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.18.1",
    "basic-auth": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "cron-parser": "^5.6.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.5",
    "mongodb": "^6.5.0",
    "mongoose": "^9.7.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.5",
    "node-cron": "^4.5.0",
    "node-telegram-bot-api": "^1.1.2",
    "openai": "^6.45.0",
    "redis": "^6.0.1",
    "resend": "^6.16.0",
    "session-file-store": "^1.5.0",
    "ssh2-sftp-client": "^12.1.1",
    "stripe": "^22.3.0",
    "terminal-kit": "^3.1.3",
    "vm2": "^3.11.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.0.2"
  }
}

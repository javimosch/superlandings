<article class="group cursor-pointer" onclick="window.location='/<%= post.slug %>'">
    <div class="p-8 rounded-xl bg-[#0a0a0a] border border-[#1f2937] hover:border-[#22c55e]/50 transition-all duration-300 hover:-translate-y-0.5">
        <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
            <% if (post.category) { %>
            <span class="px-2 py-1 rounded-md bg-[#22c55e]/10 text-[#86efac] border border-[#22c55e]/20"><%= post.category %></span>
            <span>·</span>
            <% } %>
            <% if (post.publishedAt) { %>
            <span><%= new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %></span>
            <% } %>
        </div>
        <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-[#86efac] transition-colors">
            <%= post.title %>
        </h2>
        <p class="text-gray-400 leading-relaxed mb-4">
            <%= post.excerpt || '' %>
        </p>
        <% if (post.tags && post.tags.length > 0) { %>
        <div class="flex flex-wrap gap-1.5 mb-4">
            <% post.tags.forEach(function(t) { %>
            <span class="px-2 py-0.5 rounded bg-[#111] text-gray-500 border border-[#1f2937] text-[11px]">#<%= t %></span>
            <% }); %>
        </div>
        <% } %>
        <a href="/<%= post.slug %>" class="inline-flex items-center gap-1 text-sm text-[#22c55e] font-semibold hover:text-[#86efac] transition-colors">
            Read more
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
    </div>
</article>

<script>
  /**
   * scripts-modules.ejs
   * Feature-specific logic for Cloudflare, Migrations, Settings, Logout, and generic helpers.
   */
  (function () {
    window.AppModules = window.AppModules || {};

    window.AppModules.core = function (services, helpers) {
      return {
        // Auth Helpers
        async loadAuthInfo() {
          try {
            const res = await fetch('/api/auth/me', { headers: this.getHeaders() });
            this.authInfo = await res.json();
          } catch (err) {
            console.error('Error loading auth info:', err);
          }
        },

        getHeaders() {
          const headers = {};
          if (this.currentOrganization) {
            headers['X-Organization-Id'] = this.currentOrganization.id;
          }
          return headers;
        },

        initCurrentOrganization() {
          const savedOrgId = localStorage.getItem('currentOrganizationId');
          if (savedOrgId) {
            const org = this.organizations.find(o => o.id === savedOrgId);
            if (org) {
              this.currentOrganization = org;
              return;
            }
          }
          if (this.organizations.length > 0) {
            this.currentOrganization = this.organizations[0];
            localStorage.setItem('currentOrganizationId', this.currentOrganization.id);
          }
        },

        switchOrganization(org) {
          this.currentOrganization = org;
          localStorage.setItem('currentOrganizationId', org.id);
          this.showOrgSwitcher = false;
          this.loadLandings();
          this.showSuccess(`Switched to ${org.name}`);
        },

        getOrgName(orgId) {
          const org = this.organizations.find(o => o.id === orgId);
          return org ? org.name : 'Unknown';
        },

        async loadAdminConfig() {
          try {
            const res = await fetch('/api/admin-config');
            this.adminConfig = await res.json();
          } catch (err) {
            console.error('Error loading admin config:', err);
          }
        },

        async logout() {
          try {
            await fetch('/api/logout');
          } catch (err) {
            console.log('Logout request completed');
          }
          window.location.href = '/login';
        },

        // Migrations
        async runMigration() {
          this.loading.migration = true;
          try {
            const res = await fetch('/api/migration/rbac', { method: 'POST' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            this.showSuccess(data.message);
            await this.loadOrganizations();
            this.initCurrentOrganization();
            await this.loadLandings();
          } catch (err) {
            this.showError('Error running migration: ' + err.message);
          } finally {
            this.loading.migration = false;
          }
        },

        async runVersionMigration() {
          this.loading.versionMigration = true;
          try {
            const res = await fetch('/api/migration/versions', { method: 'POST' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            this.showSuccess(data.message);
            await this.loadLandings();
          } catch (err) {
            this.showError('Error running version migration: ' + err.message);
          } finally {
            this.loading.versionMigration = false;
          }
        },

        async reloadTemplates() {
          if (!services.adminConfig) throw new Error('Admin config service missing');
          this.loading.templateReload = true;
          try {
            const { ok, data } = await services.adminConfig().reloadTemplates();
            if (!ok) throw new Error(data.error || 'Failed to reload templates');
            this.showSuccess(data.message || 'Templates reloaded');
          } catch (err) {
            this.showError('Error reloading templates: ' + err.message);
          } finally {
            this.loading.templateReload = false;
          }
        },

        // Settings Methods
        loadLocalSettings() {
          const settings = {};
          this.localStorageSettingsConfig.forEach(config => {
            settings[config.id] = localStorage.getItem(`sl_setting_${config.id}`) || '';
          });
          this.localSettings = settings;
        },

        async saveLocalSettings() {
          this.localStorageSettingsConfig.forEach(config => {
            localStorage.setItem(`sl_setting_${config.id}`, this.localSettings[config.id] || '');
          });
          this.showSuccess('Local settings saved!');
          this.showSettingsModal = false;
        },

        async loadDbSettings() {
          this.loading.loadDbSettings = true;
          try {
            const keys = ['TRAEFIK_ENABLED', 'TRAEFIK_REMOTE_HOST', 'TRAEFIK_REMOTE_USER', 'TRAEFIK_REMOTE_PORT', 'TRAEFIK_REMOTE_PATH', 'SERVER_IP', 'TRAEFIK_SSH_KEY', 'LLM_OPENROUTER_API_KEY', 'LLM_MODEL', 'LLM_TEMPERATURE', 'LLM_TIMEOUT_SECONDS'];
            const auth = btoa('<%= ADMIN_USERNAME %>:<%= ADMIN_PASSWORD %>');
            
            // Parallel fetch for settings and fallbacks
            const [settingsRes, fallbacksRes] = await Promise.all([
              fetch('/saas/api/admin/settings', {
                headers: { 'Accept': 'application/json', 'Authorization': `Basic ${auth}` }
              }),
              fetch('/api/admin-config/fallbacks', { headers: this.getHeaders() })
            ]);

            if (settingsRes.status === 401) {
              this.showError('Unauthorized access to shared settings.');
              return;
            }

            if (!settingsRes.ok) throw new Error('Failed to fetch settings');
            const allSettings = await settingsRes.json();
            
            keys.forEach(key => {
              const setting = allSettings.find(s => s.key === key);
              if (setting) {
                this.dbSettings[key] = key === 'TRAEFIK_ENABLED' ? setting.value === 'true' : setting.value;
              }
            });

            if (fallbacksRes.ok) {
              this.dbSettingsFallbacks = await fallbacksRes.json();
            }
          } catch (err) {
            console.error('Error loading DB settings:', err);
            this.showError('Could not load shared settings');
          } finally {
            this.loading.loadDbSettings = false;
          }
        },

        async saveDbSettings() {
          this.loading.saveDbSettings = true;
          try {
            const auth = btoa('<%= ADMIN_USERNAME %>:<%= ADMIN_PASSWORD %>');
            const headers = { 'Content-Type': 'application/json', 'Accept': 'application/json', 'Authorization': `Basic ${auth}` };
            const keys = ['TRAEFIK_ENABLED', 'TRAEFIK_REMOTE_HOST', 'TRAEFIK_REMOTE_USER', 'TRAEFIK_REMOTE_PORT', 'TRAEFIK_REMOTE_PATH', 'SERVER_IP', 'TRAEFIK_SSH_KEY', 'LLM_OPENROUTER_API_KEY', 'LLM_MODEL', 'LLM_TEMPERATURE', 'LLM_TIMEOUT_SECONDS'];
            for (const key of keys) {
              let value = this.dbSettings[key];
              
              // Normalize value: trim strings, ensuring SSH key has trailing newline
              if (typeof value === 'string') {
                value = value.trim();
                if (key === 'TRAEFIK_SSH_KEY' && value) {
                  value += '\n';
                }
              }
              
              if (typeof value === 'boolean') value = String(value);
              const checkRes = await fetch(`/saas/api/admin/settings/${key}`, { headers });
              if (checkRes.status === 404) {
                await fetch('/saas/api/admin/settings', {
                  method: 'POST',
                  headers,
                  body: JSON.stringify({ 
                    key, 
                    value, 
                    type: key === 'TRAEFIK_ENABLED' ? 'boolean' : 'string', 
                    description: `Traefik setting: ${key}` 
                  })
                });
              } else {
                await fetch(`/saas/api/admin/settings/${key}`, { method: 'PUT', headers, body: JSON.stringify({ value }) });
              }
            }
            this.showSuccess('Shared configuration updated successfully!');
            this.showSettingsModal = false;
          } catch (err) {
            console.error('Error saving DB settings:', err);
            this.showError('Failed to save shared settings: ' + err.message);
          } finally {
            this.loading.saveDbSettings = false;
          }
        },

        getSetting(id) {
          return localStorage.getItem(`sl_setting_${id}`) || '';
        },

        // Editors
        initAddEditor() {
          if (this.$refs.addEditorContainer && !this.addEditor) {
            const textarea = document.createElement('textarea');
            textarea.value = this.newLanding.content;
            this.$refs.addEditorContainer.appendChild(textarea);
            this.addEditor = CodeMirror.fromTextArea(textarea, { mode: 'htmlmixed', lineNumbers: true, theme: 'default', lineWrapping: true });
          }
        },

        initEditEditor() {
          if (this.$refs.editEditorContainer && !this.editEditor) {
            const textarea = document.createElement('textarea');
            textarea.value = this.editingLanding.content;
            this.$refs.editEditorContainer.appendChild(textarea);
            this.editEditor = CodeMirror.fromTextArea(textarea, { 
              mode: 'htmlmixed', lineNumbers: true, theme: 'default', lineWrapping: true,
              extraKeys: { 
                "Ctrl-F": "findPersistent", 
                "F3": "findNext", 
                "Ctrl-G": "findNext", 
                "Shift-Ctrl-G": "findPrev", 
                "Shift-F3": "findPrev",
                "Ctrl-S": (cm) => {
                  this.saveEdit(true);
                }
              }
            });
            this.editEditor.setSize('100%', '100%');
          }
        },

        initTraefikEditor(mode) {
          this.$nextTick(() => {
            const container = mode === 'add' ? this.$refs.addTraefikEditorContainer : this.$refs.editTraefikEditorContainer;
            if (container) {
              const textarea = document.createElement('textarea');
              textarea.value = mode === 'add' ? this.newLanding.content : this.editingLanding.content;
              container.innerHTML = '';
              container.appendChild(textarea);
              const editor = CodeMirror.fromTextArea(textarea, {
                mode: 'yaml',
                lineNumbers: true,
                theme: 'default',
                lineWrapping: true,
                extraKeys: {
                  "Ctrl-S": (cm) => {
                    this.saveEdit(true);
                  }
                }
              });
              editor.setSize('100%', '100%');
              if (mode === 'add') this.addTraefikEditor = editor;
              else this.editTraefikEditor = editor;
            }
          });
        },

        async generateTraefikWithAi(mode) {
          if (!this.traefikAiPrompt) {
            this.showError('Please describe what you want to achieve.');
            return;
          }
          this.generatingAi = true;
          try {
            const slug = mode === 'add' ? this.newLanding.slug : this.editingLanding.slug;
            const domains = mode === 'add' ? this.newLanding.domains : this.editingLanding.domains;
            
            const res = await fetch('/api/landings/generate-traefik-config', {
              method: 'POST',
              headers: { ...this.getHeaders(), 'Content-Type': 'application/json' },
              body: JSON.stringify({ prompt: this.traefikAiPrompt, slug, domains })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            
            const editor = mode === 'add' ? this.addTraefikEditor : this.editTraefikEditor;
            if (editor) {
              editor.setValue(data.yaml);
            } else {
              if (mode === 'add') this.newLanding.content = data.yaml;
              else this.editingLanding.content = data.yaml;
            }
            this.showSuccess('Traefik configuration generated!');
          } catch (err) {
            this.showError('Error generating Traefik config: ' + err.message);
          } finally {
            this.generatingAi = false;
          }
        },

        async runAiEdit() {
          if (!this.landingAiPrompt) {
            this.showError('Please describe what changes you want to make.');
            return;
          }
          
          // Get current content from editor or fallback to editingLanding.content
          const currentContent = this.editEditor ? this.editEditor.getValue() : this.editingLanding.content;
          
          this.generatingAi = true;
          try {
            const res = await fetch(`/api/landings/${this.editingLanding.id}/ai-edit`, {
              method: 'POST',
              headers: { ...this.getHeaders(), 'Content-Type': 'application/json' },
              body: JSON.stringify({ 
                prompt: this.landingAiPrompt, 
                currentContent: currentContent 
              })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            
            // Update editor with the modified content
            if (this.editEditor) {
              this.editEditor.setValue(data.content);
            } else {
              this.editingLanding.content = data.content;
            }
            
            this.showSuccess('AI edit applied successfully!');
            this.landingAiPrompt = ''; // Clear the prompt after successful edit
          } catch (err) {
            this.showError('Error with AI edit: ' + err.message);
          } finally {
            this.generatingAi = false;
          }
        },

        // Preview dirty changes
        previewDirtyChanges(mode = 'modal') {
          if (!this.editingLanding) return;
          
          // Get the current content from the editor
          let content = this.editingLanding.content;
          if (this.editEditor) {
            content = this.editEditor.getValue();
          }
          
          if (!content || content.trim() === '') {
            this.showError('No content to preview');
            return;
          }
          
          this.previewContent = content;
          this.previewMode = mode;
          
          if (mode === 'modal') {
            this.showPreviewModal = true;
          } else if (mode === 'tab') {
            this.openPreviewInNewTab(content);
          }
        },
        
        openPreviewInNewTab(content) {
          const blob = new Blob([content], { type: 'text/html' });
          const url = URL.createObjectURL(blob);
          window.open(url, '_blank');
          // Clean up the URL after a short delay
          setTimeout(() => URL.revokeObjectURL(url), 100);
        },
        
        closePreviewModal() {
          this.showPreviewModal = false;
        },

        // Formatter Bridge (using AppHelpers)
        formatDate(dateStr) { return helpers.formatDate(dateStr); },
        formatVersionDate(dateStr) { return helpers.formatVersionDate(dateStr); },
        formatBytes(bytes) { return helpers.formatBytes(bytes); },
        countChanges(fileDiff) { return helpers.countChanges(fileDiff); },
        countChangesNum(fileDiff) { return helpers.countChangesNum(fileDiff); }
      };
    };
  })();
</script>

<script>
  // Shared helpers and utilities for the modularized admin frontend.
  (function () {
    const helpers = {
      buildHeaders(currentOrganization) {
        const headers = {};
        if (currentOrganization?.id) headers['X-Organization-Id'] = currentOrganization.id;
        return headers;
      },
      formatDate(dateStr) {
        return new Date(dateStr).toLocaleDateString();
      },
      initIconsOnce(state) {
        if (state.iconsInitialized) return;
        state.iconsInitialized = true;
      },
      createToastStore() {
        return {
          list: [],
          add(toast) { this.list.push(toast); },
          remove(id) { this.list = this.list.filter(t => t.id !== id); }
        };
      }
    };

    window.AppHelpers = helpers;
  })();
</script>

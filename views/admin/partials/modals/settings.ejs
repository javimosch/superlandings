<!-- Settings Modal -->
<div v-if="showSettingsModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-3 sm:p-4 z-[60]">
  <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] flex flex-col">
    <!-- Header -->
    <div class="px-4 sm:px-6 py-3 sm:py-4 bg-gray-50 border-b flex justify-between items-center">
      <h3 class="text-lg sm:text-xl font-semibold text-gray-900 flex items-center gap-2">
        <i class="ti ti-settings text-blue-600"></i>
        System Settings
      </h3>
      <button @click="showSettingsModal = false" class="text-gray-500 hover:text-gray-700">
        <i class="ti ti-x w-6 h-6"></i>
      </button>
    </div>
    
    <!-- Tabs -->
    <div class="flex border-b bg-gray-50">
      <button 
        @click="settingsTab = 'db'"
        :class="['px-6 py-3 text-sm font-medium border-b-2 transition', settingsTab === 'db' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-gray-500 hover:text-gray-700 hover:bg-gray-100']"
      >
        <i class="ti ti-server mr-2"></i> Deployment Config
      </button>
      <button 
        @click="settingsTab = 'local'"
        :class="['px-6 py-3 text-sm font-medium border-b-2 transition', settingsTab === 'local' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-gray-500 hover:text-gray-700 hover:bg-gray-100']"
      >
        <i class="ti ti-device-floppy mr-2"></i> LocalStorage
      </button>
      <button 
        @click="settingsTab = 'ai'"
        :class="['px-6 py-3 text-sm font-medium border-b-2 transition', settingsTab === 'ai' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-gray-500 hover:text-gray-700 hover:bg-gray-100']"
      >
        <i class="ti ti-sparkles mr-2"></i> AI Assistant
      </button>
    </div>

    <!-- Content -->
    <div class="flex-1 overflow-y-auto p-4 sm:p-6">
      <!-- LocalStorage Tab -->
      <!-- ... (LocalStorage content remains same) ... -->
      <div v-if="settingsTab === 'local'" class="space-y-6">
        <div v-for="setting in localStorageSettingsConfig" :key="setting.id" class="space-y-2">
          <label :for="setting.id" class="block text-sm font-semibold text-gray-700">
            {{ setting.label }}
            <span v-if="setting.required" class="text-red-500">*</span>
          </label>
          <p v-if="setting.description" class="text-xs text-gray-500 mb-2">{{ setting.description }}</p>
          
          <template v-if="setting.type === 'textarea'">
            <textarea 
              v-model="localSettings[setting.id]"
              :id="setting.id"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm font-mono h-32"
              :placeholder="setting.placeholder"
            ></textarea>
          </template>
          
          <template v-else-if="setting.type === 'password'">
            <input 
              v-model="localSettings[setting.id]"
              type="password"
              :id="setting.id"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              :placeholder="setting.placeholder"
            >
          </template>
          
          <template v-else>
            <input 
              v-model="localSettings[setting.id]"
              type="text"
              :id="setting.id"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              :placeholder="setting.placeholder"
            >
          </template>
        </div>

        <div v-if="localStorageSettingsConfig.length === 0" class="text-center py-8 text-gray-500">
          <i class="ti ti-info-circle text-4xl mb-2 block"></i>
          <p>No local settings configured.</p>
        </div>
      </div>

      <!-- AI Assistant Tab -->
      <div v-if="settingsTab === 'ai'" class="space-y-8">
        <div>
          <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
            <i class="ti ti-sparkles text-purple-600"></i>
            AI Configuration
          </h4>
          
          <div class="space-y-4 bg-purple-50 p-4 rounded-lg border border-purple-200">
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">OpenRouter API Key</label>
              <input v-model="dbSettings.LLM_OPENROUTER_API_KEY" type="password" placeholder="sk-or-v1-..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-sm">
              <p v-if="dbSettingsFallbacks.LLM_OPENROUTER_API_KEY" class="text-[10px] text-gray-400 italic">
                Fallback: [Encrypted Key Detected] (used if empty)
              </p>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">AI Model for Code Editor</label>
              <input v-model="dbSettings.LLM_MODEL" type="text" placeholder="e.g. minimax/minimax-m2.1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-sm">
              <p v-if="dbSettingsFallbacks.LLM_MODEL" class="text-[10px] text-gray-400 italic">
                Fallback: {{ dbSettingsFallbacks.LLM_MODEL }} (used if empty)
              </p>
              
              <div class="mt-4 p-3 bg-white rounded border border-purple-100">
                <p class="text-[11px] font-semibold text-purple-900 mb-2">Recommended Models:</p>
                <ul class="text-[10px] text-purple-700 space-y-1 font-mono">
                  <li class="flex items-center gap-2">
                    <button @click="dbSettings.LLM_MODEL = 'minimax/minimax-m2.1'" class="hover:underline text-blue-600">minimax/minimax-m2.1</button>
                    <span class="text-gray-400">(Default)</span>
                  </li>
                  <li><button @click="dbSettings.LLM_MODEL = 'x-ai/grok-4-fast'" class="hover:underline text-blue-600">x-ai/grok-4-fast</button></li>
                  <li><button @click="dbSettings.LLM_MODEL = 'kwaipilot/kat-coder-pro'" class="hover:underline text-blue-600">kwaipilot/kat-coder-pro</button></li>
                  <li><button @click="dbSettings.LLM_MODEL = 'mistralai/devstral-2512'" class="hover:underline text-blue-600">mistralai/devstral-2512</button></li>
                </ul>
              </div>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700 flex justify-between">
                <span>Creativity (Temperature)</span>
                <span class="font-mono text-purple-600">{{ dbSettings.LLM_TEMPERATURE }}</span>
              </label>
              <input v-model="dbSettings.LLM_TEMPERATURE" type="range" min="0" max="2" step="0.1" class="w-full h-2 bg-purple-200 rounded-lg appearance-none cursor-pointer accent-purple-600">
              <div class="flex justify-between text-[10px] text-gray-400 font-mono">
                <span>0.0 (Strict)</span>
                <span>1.0 (Balanced)</span>
                <span>2.0 (Creative)</span>
              </div>
              <p v-if="dbSettingsFallbacks.LLM_TEMPERATURE" class="text-[10px] text-gray-400 italic">
                Fallback: {{ dbSettingsFallbacks.LLM_TEMPERATURE }} (used if empty)
              </p>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Request Timeout (seconds)</label>
              <input v-model="dbSettings.LLM_TIMEOUT_SECONDS" type="number" placeholder="80" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-sm">
              <p class="text-[10px] text-gray-500">
                Maximum time to wait for an AI response. Default: 80s.
              </p>
              <p v-if="dbSettingsFallbacks.LLM_TIMEOUT_SECONDS" class="text-[10px] text-gray-400 italic">
                Fallback: {{ dbSettingsFallbacks.LLM_TIMEOUT_SECONDS }} (used if empty)
              </p>
            </div>
          </div>
        </div>

        <div class="p-4 bg-blue-50 rounded-lg border border-blue-100 flex gap-3">
          <i class="ti ti-info-circle text-blue-600 text-lg"></i>
          <p class="text-xs text-blue-800">
            These settings power both the Traefik Config generator and the AI Landing Page Editor.
          </p>
        </div>
      </div>

      <!-- Deployment Config Tab -->
      <div v-if="settingsTab === 'db'" class="space-y-8">
        <div>
          <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
            <i class="ti ti-route text-blue-600"></i>
            Traefik Gateway Settings
          </h4>
          
          <div class="space-y-4 bg-gray-50 p-4 rounded-lg border border-gray-200">
            <div class="flex items-center justify-between">
              <div>
                <label class="block text-sm font-semibold text-gray-700">Enable Traefik</label>
                <p class="text-xs text-gray-500">Enable or disable domain publishing via Traefik</p>
                <p v-if="dbSettingsFallbacks.TRAEFIK_ENABLED !== undefined" class="mt-1 text-[10px] text-gray-400 italic">
                  Fallback: {{ dbSettingsFallbacks.TRAEFIK_ENABLED }} (used if empty)
                </p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" v-model="dbSettings.TRAEFIK_ENABLED" class="sr-only peer">
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label class="block text-sm font-semibold text-gray-700">Remote Host</label>
                <input v-model="dbSettings.TRAEFIK_REMOTE_HOST" type="text" placeholder="e.g. 188.245.71.48" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                <p v-if="dbSettingsFallbacks.TRAEFIK_REMOTE_HOST" class="text-[10px] text-gray-400 italic">
                  Fallback: {{ dbSettingsFallbacks.TRAEFIK_REMOTE_HOST }} (used if empty)
                </p>
              </div>
              <div class="space-y-1">
                <label class="block text-sm font-semibold text-gray-700">Remote User</label>
                <input v-model="dbSettings.TRAEFIK_REMOTE_USER" type="text" placeholder="e.g. root" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                <p v-if="dbSettingsFallbacks.TRAEFIK_REMOTE_USER" class="text-[10px] text-gray-400 italic">
                  Fallback: {{ dbSettingsFallbacks.TRAEFIK_REMOTE_USER }} (used if empty)
                </p>
              </div>
              <div class="space-y-1">
                <label class="block text-sm font-semibold text-gray-700">Remote Port</label>
                <input v-model="dbSettings.TRAEFIK_REMOTE_PORT" type="text" placeholder="e.g. 22" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                <p v-if="dbSettingsFallbacks.TRAEFIK_REMOTE_PORT" class="text-[10px] text-gray-400 italic">
                  Fallback: {{ dbSettingsFallbacks.TRAEFIK_REMOTE_PORT }} (used if empty)
                </p>
              </div>
              <div class="space-y-1">
                <label class="block text-sm font-semibold text-gray-700">Remote Path</label>
                <input v-model="dbSettings.TRAEFIK_REMOTE_PATH" type="text" placeholder="e.g. /etc/traefik/dynamic" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                <p v-if="dbSettingsFallbacks.TRAEFIK_REMOTE_PATH" class="text-[10px] text-gray-400 italic">
                  Fallback: {{ dbSettingsFallbacks.TRAEFIK_REMOTE_PATH }} (used if empty)
                </p>
              </div>
              <div class="space-y-1">
                <label class="block text-sm font-semibold text-gray-700">Internal Server IP</label>
                <input v-model="dbSettings.SERVER_IP" type="text" placeholder="e.g. http://10.0.0.5:3000" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                <p v-if="dbSettingsFallbacks.SERVER_IP" class="text-[10px] text-gray-400 italic">
                  Fallback: {{ dbSettingsFallbacks.SERVER_IP }} (used if empty)
                </p>
              </div>
            </div>

            <div class="space-y-1 sm:col-span-2">
              <label class="block text-sm font-semibold text-gray-700">Traefik SSH Private Key</label>
              <p class="text-xs text-gray-500 mb-2">Private key used for SSH/SCP interactions with the remote host. Stored securely on the server.</p>
              <textarea 
                v-model="dbSettings.TRAEFIK_SSH_KEY"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm font-mono h-32"
                placeholder="-----BEGIN OPENSSH PRIVATE KEY-----\n..."
              ></textarea>
              <p v-if="dbSettingsFallbacks.TRAEFIK_SSH_KEY" class="text-[10px] text-gray-400 italic mt-1">
                Fallback: [Encrypted Key Detected] (used if empty)
              </p>
            </div>
          </div>
        </div>

        <div>
          <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
            <i class="ti ti-sparkles text-purple-600"></i>
            AI Assistance (Traefik Config)
          </h4>
          
          <div class="space-y-4 bg-purple-50 p-4 rounded-lg border border-purple-200">
            <p class="text-xs text-purple-800">
              This configuration is required for the <strong>AI Assistant</strong> in the <strong>Traefik Custom Config</strong> landing type. 
              It allows you to describe Traefik rules (redirects, proxies, etc.) in plain text and generate the YAML configuration automatically.
            </p>
            
            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">OpenRouter API Key</label>
              <input v-model="dbSettings.LLM_OPENROUTER_API_KEY" type="password" placeholder="sk-or-v1-..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-sm">
              <p v-if="dbSettingsFallbacks.LLM_OPENROUTER_API_KEY" class="text-[10px] text-gray-400 italic">
                Fallback: [Encrypted Key Detected] (used if empty)
              </p>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">AI Model</label>
              <input v-model="dbSettings.LLM_MODEL" type="text" placeholder="e.g. google/gemini-2.5-flash-lite" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-sm">
              <p v-if="dbSettingsFallbacks.LLM_MODEL" class="text-[10px] text-gray-400 italic">
                Fallback: {{ dbSettingsFallbacks.LLM_MODEL }} (used if empty)
              </p>
              <p class="text-[10px] text-gray-500">
                Default: google/gemini-2.5-flash-lite (via OpenRouter)
              </p>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-semibold text-gray-700">Request Timeout (seconds)</label>
              <input v-model="dbSettings.LLM_TIMEOUT_SECONDS" type="number" placeholder="80" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-sm">
              <p class="text-[10px] text-gray-500">
                Default: 80s
              </p>
            </div>
          </div>
        </div>

        <div class="p-4 bg-blue-50 rounded-lg border border-blue-100 flex gap-3">
          <i class="ti ti-info-circle text-blue-600 text-lg"></i>
          <p class="text-xs text-blue-800">
            These settings are stored securely on the server and applied to all deployments. 
            Changing them will affect future domain publications.
          </p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-4 sm:px-6 py-3 sm:py-4 bg-gray-50 border-t flex justify-between items-center">
      <div class="text-xs text-gray-500">
        <span v-if="settingsTab === 'local'" class="flex items-center gap-1">
          <i class="ti ti-shield-check text-green-600"></i>
          Stored locally in your browser
        </span>
        <span v-if="settingsTab === 'db'" class="flex items-center gap-1">
          <i class="ti ti-world text-blue-600"></i>
          Shared server configuration
        </span>
      </div>
      <div class="flex gap-3">
        <button 
          @click="showSettingsModal = false" 
          class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200 rounded-lg transition"
        >
          Cancel
        </button>
        <button 
          v-if="settingsTab === 'local'"
          @click="saveLocalSettings" 
          class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition flex items-center gap-2"
        >
          <i class="ti ti-device-floppy"></i>
          Save Local
        </button>
        <button 
          v-if="settingsTab === 'db' || settingsTab === 'ai'"
          @click="saveDbSettings" 
          class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition flex items-center gap-2"
          :disabled="loading.saveDbSettings"
        >
          <span v-if="loading.saveDbSettings" class="animate-spin mr-2"><i class="ti ti-loader-2"></i></span>
          <i v-else class="ti ti-device-floppy"></i>
          Save Shared Config
        </button>
      </div>
    </div>
  </div>
</div>

<main class="w-full px-3 sm:px-4 py-6 sm:py-8">
  <div class="mb-6 flex gap-2 sm:gap-4 flex-wrap">
    <button v-if="canCreate" @click="showAddModal = true" class="bg-slate-900 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg hover:bg-slate-800 transition font-semibold shadow-md text-sm sm:text-base flex items-center gap-2">
      <i class="ti ti-circle-plus text-lg"></i>
      + Add New Landing
    </button>
    <!-- Admin: Migration RBAC -->
    <button v-if="authInfo.isAdmin" @click="runMigration" :disabled="loading.migration" class="bg-slate-800 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg hover:bg-slate-700 transition font-semibold shadow-md disabled:opacity-50 text-sm sm:text-base flex items-center gap-2">
      <i v-if="loading.migration" class="ti ti-loader-2 w-5 h-5 animate-spin"></i>
      <i v-else class="ti ti-arrows-right-left text-lg"></i>
      <span>{{ loading.migration ? 'Migrating...' : 'Migration RBAC' }}</span>
    </button>
    <!-- Admin: Migration Versions -->
    <button v-if="authInfo.isAdmin" @click="runVersionMigration" :disabled="loading.versionMigration" class="bg-slate-800 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg hover:bg-slate-700 transition font-semibold shadow-md disabled:opacity-50 text-sm sm:text-base flex items-center gap-2">
      <i v-if="loading.versionMigration" class="ti ti-loader-2 w-5 h-5 animate-spin"></i>
      <i v-else class="ti ti-scroll text-lg"></i>
      <span>{{ loading.versionMigration ? 'Migrating...' : 'Migration Versions' }}</span>
    </button>
  </div>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="px-3 sm:px-6 py-3 sm:py-4 bg-gray-50 border-b flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
      <h2 class="text-lg sm:text-xl font-semibold text-gray-800">Landing Pages</h2>
      <span v-if="currentOrganization" class="text-xs sm:text-sm text-gray-500 truncate">Showing landings for: {{ currentOrganization.name }}</span>
    </div>
    
    <div v-if="landings.length === 0" class="px-3 sm:px-6 py-12 text-center text-gray-500">
      <p class="text-base sm:text-lg">No landing pages yet. <span v-if="canCreate">Create your first one!</span></p>
    </div>

    <div v-else class="divide-y">
      <div v-for="landing in landings" :key="landing.id" class="px-3 sm:px-6 py-4 hover:bg-gray-50 transition">
        <div class="flex flex-col gap-3">
          <div>
            <h3 class="text-base sm:text-lg font-semibold text-gray-900 break-words">{{ landing.name }}</h3>
            <div class="mt-2 flex items-center gap-2 text-xs sm:text-sm text-gray-600 flex-wrap">
              <span class="flex items-center">
                <i class="ti ti-link mr-1 flex-shrink-0 text-slate-500 text-base"></i>
                <a :href="'/' + landing.slug" target="_blank" class="hover:text-slate-700 truncate">/{{ landing.slug }}</a>
              </span>
              <span class="px-2 py-1 bg-slate-100 text-slate-700 rounded text-xs font-medium uppercase flex-shrink-0">{{ landing.type }}</span>
              <span v-if="landing.published" class="px-2 py-1 bg-emerald-100 text-emerald-700 rounded text-xs font-medium flex-shrink-0 flex items-center gap-1">
                <i class="ti ti-badge-check text-base"></i> Published
              </span>
              <span v-if="landing.currentVersionNumber" class="px-2 py-1 bg-sky-100 text-sky-700 rounded text-xs font-medium flex-shrink-0 flex items-center gap-1">
                <i class="ti ti-scroll text-base"></i> v{{ landing.currentVersionNumber }}
              </span>
            </div>
            <div v-if="landing.domains && landing.domains.length > 0" class="mt-2 text-xs sm:text-sm text-gray-600 flex-wrap">
              <span class="block flex items-start gap-1">
                <i class="ti ti-world text-base mt-0.5 text-slate-500"></i>
                <template v-if="landing.published">
                  <template v-for="(domainObj, idx) in landing.domains.filter(d => d.published)" :key="idx">
                    <a :href="'https://' + domainObj.domain" target="_blank" class="text-emerald-700 hover:text-slate-800 underline">{{ domainObj.domain }}</a><span v-if="idx < landing.domains.filter(d => d.published).length - 1">, </span>
                  </template>
                  <span v-if="landing.domains.some(d => !d.published)" class="text-gray-400 ml-1">({{ landing.domains.filter(d => !d.published).length }} unpublished)</span>
                </template>
                <template v-else>
                  {{ landing.domains.length }} domain{{ landing.domains.length > 1 ? 's' : '' }}
                </template>
              </span>
            </div>
            <span class="text-xs text-gray-500 block mt-1">{{ formatDate(landing.createdAt) }}</span>
          </div>
          <div class="flex gap-2 flex-wrap text-xs sm:text-sm">
            <!-- Domains button - requires landings:domains permission -->
            <button v-if="canDomains" @click="openDomainsModal(landing)" title="Domains" class="px-2 sm:px-3 py-2 bg-slate-100 text-slate-800 rounded hover:bg-slate-200 transition font-medium flex-shrink-0 flex items-center gap-1">
              <i class="ti ti-world text-base"></i>
            </button>
            <!-- Publish/Unpublish - requires landings:domains permission -->
            <button v-if="canDomains && !landing.published && landing.domains && landing.domains.length > 0" @click="publishLanding(landing.id)" :disabled="loading[landing.id]" class="px-2 sm:px-3 py-2 bg-emerald-100 text-emerald-700 rounded hover:bg-emerald-200 transition font-medium disabled:opacity-50 disabled:cursor-not-allowed flex-shrink-0 flex items-center gap-1">
              <i v-if="loading[landing.id]" class="ti ti-loader-2 w-4 h-4 animate-spin"></i>
              <span v-else>Publish</span>
            </button>
            <button v-if="canDomains && landing.published" @click="unpublishLanding(landing.id)" :disabled="loading[landing.id]" class="px-2 sm:px-3 py-2 bg-amber-100 text-amber-800 rounded hover:bg-amber-200 transition font-medium disabled:opacity-50 disabled:cursor-not-allowed flex-shrink-0 flex items-center gap-1">
              <i v-if="loading[landing.id]" class="ti ti-loader-2 w-4 h-4 animate-spin"></i>
              <span v-else>Unpublish</span>
            </button>
            <!-- Edit - requires landings:update permission -->
            <button v-if="canUpdate && (landing.type === 'html' || landing.type === 'ejs' || landing.type === 'traefik-config' || landing.type === 'virtual')" @click="editLanding(landing)" class="px-2 sm:px-3 py-2 bg-slate-100 text-slate-800 rounded hover:bg-slate-200 transition font-medium flex-shrink-0">
              Edit
            </button>
            <!-- Versions - requires landings:update permission -->
            <button v-if="canUpdate" @click="openVersionsModal(landing)" title="Versions" class="px-2 sm:px-3 py-2 bg-sky-100 text-sky-700 rounded hover:bg-sky-200 transition font-medium flex-shrink-0 flex items-center gap-1">
              <i class="ti ti-versions text-base"></i>
            </button>
            <!-- Audit - requires landings:update permission -->
            <button v-if="canUpdate" @click="openAuditModal(landing)" title="Audit log" class="px-2 sm:px-3 py-2 bg-amber-100 text-amber-800 rounded hover:bg-amber-200 transition font-medium flex-shrink-0 flex items-center gap-1">
              <i class="ti ti-clipboard-list text-base"></i>
            </button>
            <!-- Move - admin only -->
            <button v-if="authInfo.isAdmin && organizations.length > 1" @click="openMoveModal(landing)" class="px-2 sm:px-3 py-2 bg-slate-100 text-slate-800 rounded hover:bg-slate-200 transition font-medium flex-shrink-0">
              Move
            </button>
            <!-- Clear cache (mongo landing cache) -->
            <button v-if="canUpdate" @click="clearLandingCache(landing)" :disabled="loading[`cache-${landing.id}`]" class="px-2 sm:px-3 py-2 bg-amber-100 text-amber-800 rounded hover:bg-amber-200 transition font-medium disabled:opacity-50 flex-shrink-0 flex items-center gap-1">
              <i v-if="loading[`cache-${landing.id}`]" class="ti ti-loader-2 w-4 h-4 animate-spin"></i>
              <span v-else>Clear cache</span>
            </button>
            <!-- Delete - requires landings:delete permission -->
            <button v-if="canDelete" @click="deleteLanding(landing.id)" class="px-2 sm:px-3 py-2 bg-rose-100 text-rose-700 rounded hover:bg-rose-200 transition font-medium flex-shrink-0">
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
